# ============================================================
#  .gitignore — что НЕ отправляем на GitHub.
#  Правило простое: в репозиторий попадает только исходный код,
#  а всё, что генерируется (зависимости, сборка, логи) — нет.
# ============================================================

# Зависимости (ставятся командой npm install у каждого своё)
node_modules/

# Результат сборки (генерится командой npm run build)
dist/
dist-ssr/

# Логи (в т.ч. наш dev-server.log)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Файлы окружения — тут могут быть секреты (ключи API и т.п.)
.env
.env.local
.env.*.local

# Кэш Vite
.vite/
*.local

# Редакторы и IDE
.vscode/*
!.vscode/extensions.json
.idea/

# Мусор операционной системы
.DS_Store
Thumbs.db
desktop.ini
